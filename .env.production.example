APP_NAME=DentalClinic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Neon PostgreSQL. Use the direct connection for migrations and the app.
# Leave the local .env on MySQL. Do not commit real values.
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_EMULATE_PREPARES=false
DUMP_PATH=pg_dump
PSQL_PATH=psql

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
MEDIA_DISK=neon
MEDIA_URL_MINUTES=720
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_SUPPORTS_CREDENTIALS=false
TRUSTED_PROXIES=*

NEON_API_BASE=https://console.neon.tech/api/v2
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_STORAGE_BUCKET=assets

# Used only by clinic:pg-migrate-test. Point this at a development branch.
NEON_BRANCH=
NEON_DEV_DATABASE_URL=

VITE_API_URL=https://api.example.com/api/
VITE_WITH_CREDENTIALS=false
